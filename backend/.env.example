DATABASE_URL=sqlite:///./data/insightiq.db
DATA_DIR=./data
MAX_UPLOAD_MB=25
MAX_RECORDS=50000
BATCH_SIZE=64
MIN_SAMPLE=20
# vader (default, lexicon-based) or transformers (needs `pip install transformers torch` + one-time model download)
SENTIMENT_BACKEND=vader
HF_SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
